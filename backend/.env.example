# Copy to .env and adjust. Contains placeholders only, never real secrets.

# Required. Path of the SQLite database file.
DATABASE_PATH=backend/demo_orders.sqlite3

# Optional. Comma-separated absolute http(s) origins allowed by CORS.
# Unset or empty means no CORS headers are sent.
ALLOWED_ORIGINS=http://localhost:5353,http://127.0.0.1:5353

# Optional. Session lifetime in seconds (3600 to 2592000). Default 604800.
TOKEN_LIFETIME_SECONDS=604800

# Optional. Exactly 1 enables the simulated payment flow; anything else returns 503.
DEMO_MODE=1

# Optional. Stripe SANDBOX secret key (sk_test_...). When set, online payments (FPX, GrabPay, card) go through
# Stripe's hosted page and orders are created only after Stripe confirms the money. Live keys (sk_live_...) are
# refused at start-up. Leave empty to use the simulated prototype gateway.
STRIPE_SECRET_KEY=
# Optional. Signing secret (whsec_...) of the Stripe webhook endpoint. Without it the app still confirms payments
# by asking Stripe while it polls; the webhook only makes confirmation faster.
STRIPE_WEBHOOK_SECRET=
# Public origin of this API, where Stripe sends the customer back. Render's RENDER_EXTERNAL_URL is used if unset.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional. Directory for uploaded images. Default: <DATABASE_PATH dir>/media
MEDIA_DIR=backend/media

# Optional. IANA time zone used for month buckets. Default Asia/Kuala_Lumpur.
APP_TIMEZONE=Asia/Kuala_Lumpur

# Seed_Script (python -m backend.seed). DEMO-ONLY account passwords; leave unset to use the documented defaults:
#   customers DemoCustomer1!  seller DemoSeller1!  admin DemoAdmin1!  artisan DemoArtisan1!
DEMO_CUSTOMER_PASSWORD=
DEMO_SELLER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_ARTISAN_PASSWORD=
